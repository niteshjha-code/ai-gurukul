# Copy this file to .env and adjust. Everything is optional for local development.

PORT=5000
# Use a long random string in production (required when NODE_ENV=production).
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins. Leave empty to allow all (dev).
CORS_ORIGIN=

# --- AI providers (all free) ---
# Pollinations (https://pollinations.ai) works with NO key and is always used as the last option.
# Add a free key below for faster and more reliable answers; the first configured one is tried first.
# Google Gemini free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional Pollinations token for higher limits
POLLINATIONS_TOKEN=

# Max AI requests per user per 10 minutes
AI_RATE_LIMIT=30
# Set to 1 to skip AI calls entirely and use built-in offline content
AI_OFFLINE=0
